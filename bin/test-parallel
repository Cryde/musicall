#!/bin/sh
# Runs the suite on every core with paratest, and the `serial` group alongside in one process.
# Run it inside the php-cli container: `composer test-parallel`.
set -eu

workers="$(nproc)"
# phpunit.dist.xml forces APP_DEBUG=0: warming the debug container would leave every worker compiling its own.
export APP_ENV=test APP_DEBUG=0

rm -rf var/cache/test
bin/console cache:warmup

# Worker N uses musicall_testN (doctrine's dbname_suffix reads TEST_TOKEN), the serial group musicall_test. The
# databases are kept between runs, so updating them is close to free, where a rebuild is seconds of DDL each.
pids=''
for token in '' $(seq 1 "$workers"); do
  (
    export TEST_TOKEN="$token"
    bin/console -q -n doctrine:database:create --if-not-exists
    bin/console -q -n doctrine:schema:update --force
  ) &
  pids="$pids $!"
done
for pid in $pids; do wait "$pid"; done

# The serial group has its own database, so it can share the machine with the paratest workers.
bin/phpunit --group serial --do-not-record-test-run-history > var/test-serial.log 2>&1 &
serial=$!

status=0
TEST_SCHEMA_READY=1 vendor/bin/paratest --processes="$workers" --exclude-group serial || status=$?
wait "$serial" || status=$?
cat var/test-serial.log
exit "$status"
